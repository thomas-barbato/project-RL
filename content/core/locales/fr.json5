    // Descriptions issues des textes joueur ; l'écran précise séparément
    // les limites des primitives actuellement simulées dans le prototype.
    "technique.rec_01.description": "Examine une cible perçue pour préciser son état, son matériel observable et les résistances ou faiblesses identifiables.",
    "technique.rec_02.description": "Examine les traces locales pour en déduire une direction et une ancienneté approximative.",
    "technique.rec_03.description": "Recherche les indices de pièges, caches, commandes dissimulées ou passages secrets dans les cases observables.",
    "technique.rec_04.description": "Examine les parois observables pour identifier un matériau peu résistant ou une dégradation exploitable.",
    "technique.rec_05.description": "Précise les possibilités offensives et défensives d'un adversaire à partir de ce qui est observable ou documenté.",
    "technique.rec_06.description": "Projette les champs visuels de tous les PNJ actuellement visibles, quels que soient leur rôle ou leur comportement. Cet affichage tactique est gratuit.",
    "technique.rec_08.description": "Examine la chaleur, l'alimentation et le stockage d'énergie accessibles d'une machine pour guider vos choix.",
    "technique.rec_09.description": "Applique Analyse de cible à plusieurs cibles perçues au cours d'une même action.",
    "technique.mel_01.description": "Porte une frappe de mêlée plus dévastatrice, suivie d'un temps de récupération.",
    "technique.mel_02.description": "Prépare une frappe pour améliorer vos chances de toucher une cible au contact.",
    "technique.mel_03.description": "Porte un coup moins puissant et tente de repousser la cible d'une case.",
    "technique.mel_04.description": "Prépare une garde réduisant les dégâts physiques de la prochaine attaque de mêlée qui vous touche.",
    "technique.mel_05.description": "Frappe jusqu'à trois cases voisines dans un arc, avec moins de dégâts par cible.",
    "technique.mel_06.description": "Ajoute une contre-attaque ordinaire après une Parade réussie si l'adversaire reste au contact.",
    "technique.mel_07.description": "Sacrifie une partie des dégâts immédiats pour fragiliser temporairement le Blindage de la cible.",
    "technique.mel_08.description": "Frappe une fonction locomotrice compatible pour tenter de ralentir brièvement les déplacements de la cible.",
    "technique.mel_09.description": "Porte une frappe particulièrement lourde contre une cible déjà entravée ou immobilisée.",
    "technique.mel_10.description": "Prépare une frappe de réaction contre une cible qui quitte volontairement le contact.",
    "technique.tir_01.description": "Prépare votre prochain tir simple pour améliorer sa précision contre une cible visible.",
    "technique.tir_02.description": "Tire une rafale plus courte avec une dispersion réduite.",
    "technique.tir_03.description": "Tire une rafale pouvant gêner brièvement la précision d'une cible touchée et exposée.",
    "technique.tir_04.description": "Prépare un tir contre le premier ennemi perçu qui entre dans le passage désigné.",
    "technique.tir_05.description": "Vise un composant identifié pour tenter d'endommager sa fonction.",
    "technique.tir_06.description": "Répartit les projectiles d'une rafale entre plusieurs cibles proches et perçues.",
    "technique.tir_07.description": "Conserve une partie du bonus de Tir visé pour vos tirs simples suivants contre la même cible.",
    "technique.tir_08.description": "Étend Surveillance à un secteur plus large sans ajouter de réaction ni de portée.",
    "technique.tir_09.description": "Prépare un tir exploitant une faiblesse connue pour ignorer une partie du Blindage.",
    "technique.tir_10.description": "Maintient un feu réparti sur une petite zone, avec une possibilité de suppression des occupants touchés.",
    "technique.dem_01.description": "Prépare le lancer d'un explosif pour réduire sa dispersion, sans renforcer l'explosion.",
    "technique.dem_02.description": "Intervient sur le déclencheur d'un dispositif identifié pour le neutraliser.",
    "technique.dem_03.description": "Pose une charge destinée à endommager fortement un obstacle destructible après un bref délai.",
    "technique.dem_04.description": "Pose une mine qui s'arme après un délai puis réagit aux présences proches.",
    "technique.dem_05.description": "Configure un explosif adapté pour concentrer son effet dans une direction choisie.",
    "technique.dem_06.description": "Commande la mise à feu d'un dispositif connu doté d'un récepteur compatible.",
    "technique.dem_07.description": "Dissipe proprement une charge manifestée neutralisée, ou récupère une charge physique lorsque l'inventaire le permet.",
    "technique.dem_08.description": "Programme plusieurs charges posées pour exploser selon une suite de délais déterminée.",
    "technique.dem_09.description": "Prépare la destruction locale d'un support structurel réellement fragilisable.",
    "technique.dem_10.description": "Associe deux charges successives ; la seconde se propage sur le terrain laissé par la première.",
    "technique.man_01.description": "Effectue un pas prudent qui améliore votre esquive uniquement contre une interception de mêlée provoquée par ce retrait.",
    "technique.man_02.description": "Prépare un appui temporaire qui augmente votre résistance aux déplacements forcés tant que vous restez immobile.",
    "technique.man_03.description": "Traverse un obstacle bas ou un intervalle d'une case lorsque le départ, le passage et l'arrivée sont compatibles.",
    "technique.man_04.description": "Avance en ligne, une case par action, puis porte une frappe de mêlée renforcée si la cible est toujours au point prévu.",
    "technique.man_05.description": "Prépare un pas vers une case adjacente si une attaque perçue vous vise et si cette case reste libre.",
    "technique.man_06.description": "Parcourt deux cases successives grâce aux propulseurs ; chaque case conserve ses dangers et ses surveillances.",
    "technique.man_08.description": "Permet d'interrompre volontairement une Charge et supprime sa récupération lorsqu'elle est menée à son terme.",
    "technique.man_09.description": "Tente de repousser un adversaire adjacent puis d'occuper son ancienne position, sans lui infliger de dégâts supplémentaires.",
    "technique.man_10.description": "Recule avec un allié adjacent coopératif afin de l'extraire vers votre ancienne position.",
    "technique.fur_01.description": "Effectue un déplacement lent en réduisant uniquement le bruit produit par ce pas.",
    "technique.fur_02.description": "Augmente passivement la difficulté de repérage optique de vos déplacements lorsqu'un couvert réel vous masque partiellement.",
    "technique.fur_03.description": "Met en veille le canal d'émission actif ; les fonctions qui l'exigent restent indisponibles jusqu'à sa réactivation.",
    "technique.fur_04.description": "Adopte une posture lente qui exploite un couvert adjacent pour réduire votre profil optique.",
    "technique.fur_05.description": "Prépare une première attaque simple plus précise et plus puissante contre une cible qui ne vous a pas localisé.",
    "technique.fur_06.description": "Manifeste à distance un leurre produisant un bruit local pendant trois phases.",
    "technique.fur_07.description": "Après rupture de vue, empêche la création de nouvelles traces pendant trois pas au plus et trois tours au plus.",
    "technique.fur_08.description": "Génère une couverture pour rendre un petit explosif posé plus difficile à repérer optiquement.",
    "technique.fur_09.description": "Masque temporairement un canal optique au prix d'énergie et de chaleur à chaque phase.",
    "technique.fur_10.description": "Renforce Embuscade au contact d'une vulnérabilité connue et réduit le bruit de cette frappe.",
    "technique.drn_01.description": "Manifeste un drone utilitaire autonome sur une case adjacente. Vous choisissez sa doctrine depuis le panneau d'allié. Lorsque sa batterie est épuisée, il se dissipe et pourra être manifesté de nouveau après la recharge de la compétence.",
    "technique.drn_02.description": "Programme un court trajet connu et une condition d'arrêt ou de retour pour un drone.",
    "technique.drn_03.description": "Envoie un drone équipé émettre un signal de diversion depuis une position choisie.",
    "technique.drn_04.description": "Envoie un drone doté d'un manipulateur chercher un objet connu et le rapporter.",
    "technique.drn_05.description": "Désigne une cible perçue pour les prochaines attaques ordinaires de plusieurs drones.",
    "technique.drn_06.description": "Ordonne à un drone de préparer la protection d'un allié contre un projectile direct.",
    "technique.drn_07.description": "Étend une patrouille par une reconnaissance limitée, suivie d'un retour et d'un rapport daté.",
    "technique.drn_08.description": "Ajoute à une consigne une condition locale simple évaluée par le drone.",
    "technique.drn_09.description": "Assigne en une procédure plusieurs positions et rôles connus à vos drones joignables.",
    "technique.drn_10.description": "Remplace les consignes offensives de plusieurs drones par un retour temporaire vers un point connu.",
    "technique.ing_01.description": "Restaure la durabilité d'un composant endommagé choisi en convertissant énergie et chaleur après une courte préparation.",
    "technique.ing_02.description": "Démonte une carcasse adjacente afin de préserver un composant survivant choisi dans son état réel.",
    "technique.ing_03.description": "Examine une panne matérielle et indique la cause observable ainsi que les moyens encore nécessaires.",
    "technique.ing_04.description": "Règle un module compatible pour privilégier l'économie d'énergie ou la puissance de sa sortie.",
    "technique.ing_05.description": "Réalise une réparation ciblée immédiate mais moins efficace et plus exigeante pour les systèmes.",
    "technique.ing_06.description": "Surcadence temporairement la sortie chiffrée d'un module, au prix d'énergie, de chaleur et d'un risque matériel annoncé.",
    "technique.ing_07.description": "Rétablit partiellement une fonction électrique dégradée en suspendant un autre composant réel du même corps.",
    "technique.ing_08.description": "Reconditionne durablement un équipement récupérable dans un atelier, sans dépasser sa durabilité réparable.",
    "technique.ing_09.description": "Assemble sur une case adjacente une balise-leurre provisoire alimentée par une réserve finie.",
    "technique.ing_10.description": "Active un surcadencement moins puissant, mais plus économe en énergie, en chaleur et en usure aux températures modérées.",
    "technique.int_01.description": "Examine une interface connue et révèle ses droits et protections observables sans accorder d'accès.",
    "technique.int_02.description": "Tente de commander une fois un verrou électronique local ; un échec laisse une trace et durcit temporairement cette interface.",
    "technique.int_03.description": "Extrait depuis une session de lecture un lot de données persistant, daté et rattaché à sa source.",
    "technique.int_04.description": "Présente un identifiant déjà extrait afin d'obtenir des droits locaux pendant quatre unités de temps.",
    "technique.int_05.description": "Maintient pendant trois unités de temps une consigne simple sur un dispositif dont vous possédez le droit de commande.",
    "technique.int_06.description": "Suspend pendant deux unités de temps une routine automatique précise, suivie d'une courte protection contre la répétition.",
    "technique.int_07.description": "Installe au plus deux accès dormants sur des systèmes compromis ou rétablit ensuite une session locale par l'un d'eux.",
    "technique.int_08.description": "Falsifie une trace locale identifiée avant son audit, sans effacer les alarmes, copies ou témoins déjà produits.",
    "technique.int_09.description": "Applique une même consigne à trois dispositifs joignables au plus, avec un droit réel et une bande passante réservée pour chacun.",
    "technique.int_10.description": "Bloque temporairement la reprise de commande ordinaire d'un dispositif déjà détourné, sans empêcher une intervention physique.",
    "technique.gel_01.description": "Émet autour de vous une impulsion électrique bloquée par les obstacles, qui touche aussi les alliés exposés.",
    "technique.gel_02.description": "Implante un sabotage augmentant la chaleur d'une machine et réduisant temporairement sa dissipation.",
    "technique.gel_03.description": "Maintient dans une petite zone un brouillage visant soit un canal de capteur, soit les liaisons de contrôle.",
    "technique.gel_04.description": "Tente de retirer un programme hostile identifié sans réparer ses dégâts ni refroidir sa cible.",
    "technique.gel_05.description": "Frappe une suite choisie de machines perçues, chaque rebond perdant de la puissance et exigeant un trajet libre.",
    "technique.gel_06.description": "Implante une campagne de dégâts thermiques périodiques pouvant tenter une transmission locale et bornée.",
    "technique.gel_07.description": "Pose une balise destructible dont la batterie alimente brièvement un champ de dégâts électriques.",
    "technique.gel_08.description": "Arme le stockage d'énergie d'une machine compatible pour une explosion physique et thermique annoncée.",
    "technique.gel_v01.description": "Transforme Surcharge en cône orienté de même portée et de même puissance.",
    "technique.gel_v02.description": "Exécute Surcharge en épargnant les alliés matériellement identifiés, au prix d'énergie et de bande passante.",
    "technique.gel_v03.description": "Accélère Surchauffe avec des pics plus forts pendant une durée plus courte.",
    "technique.gel_v04.description": "Étale Surchauffe sur cinq unités de temps avec une hausse plus lente.",
    "technique.gel_v05.description": "Ajoute à la cascade un quatrième hôte plus faiblement touché.",
    "technique.gel_v06.description": "Préserve davantage de dégâts entre les trois hôtes de la cascade, avec un coût supérieur.",
    "technique.gel_v07.description": "Autorise quatre hôtes et deux tentatives locales par hôte, mais réduit chaque dégât périodique.",
    "technique.gel_v08.description": "Concentre l'infection sur sa cible initiale, sans propagation, pour des dégâts périodiques renforcés.",
    "technique.gel_v09.description": "Étend le champ de saturation à cinq unités de temps en réduisant chaque exposition.",
    "technique.gel_v10.description": "Pose la balise inactive puis permet son activation unique par une commande liée.",
    "item.saturation_beacon.name": "Balise de saturation",
    "item.saturation_beacon.description": "Châssis destiné aux futures variantes fabriquées du champ de saturation ; la compétence de base manifeste sa propre balise.",
  },
}
