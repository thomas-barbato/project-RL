    {
      "id": "AR-N01",
      "old_review_id": null,
      "content_id": null,
      "name": "Mage · robe de canalisation",
      "kind": "outfit",
      "category": "new_mage",
      "source_reference": null,
      "source": "../../../../assets/source-art/refonte-agent-2026-10-06/armor-flat-review-01/sources/AR-N01-poses.png",
      "brief": "A long deep-blue technical robe with a clear ivory vertical front panel, a rounded reinforced hood framing an angular dark mask, broad fabric folds, dark steel pauldrons and simple technological wrist cuffs. A readable restrained occult mark on the chest; no aura, staff or book.",
      "status": "new_design_pending_review",
      "replaces_candidate": null,
      "variants": [
        "Originale",
        "Variante 2",
        "Variante 3"
      ]
    },
    {
      "id": "AR-N02",
      "old_review_id": null,
      "content_id": null,
      "name": "Mage · manteau rituel",
      "kind": "outfit",
      "category": "new_mage",
      "source_reference": null,
      "source": "../../../../assets/source-art/refonte-agent-2026-10-06/armor-flat-review-01/sources/AR-N02-poses.png",
      "brief": "A long crimson ritual coat over a black protective suit, open split lower panels, a high dark collar and enclosed narrow angular hood, light-grey reinforced shoulder pieces. Broad dark occult geometric bands woven into the robe, readable as black-magic attire, with practical cyberpunk connectors; no medieval wizard hat, no aura or held items.",
      "status": "new_design_pending_review",
      "replaces_candidate": null,
      "variants": [
        "Originale",
        "Variante 2",
        "Variante 3"
      ]
    },
    {
      "id": "AR-N03",
      "old_review_id": null,
      "content_id": null,
      "name": "Combat · armure de choc",
      "kind": "outfit",
      "category": "new_combat",
      "source_reference": null,
      "source": "../../../../assets/source-art/refonte-agent-2026-10-06/armor-flat-review-01/sources/AR-N03-poses.png",
      "brief": "A heavy industrial assault armor with substantial blue-steel and grey protective plates and burnt-orange fabric inserts. Broad angular shoulder guards, a flat closed helmet with a horizontal dark visor, reinforced thighs and shins. Technological and brutal, no medieval armor, no oversized limbs or held items.",
      "status": "new_design_pending_review",
      "replaces_candidate": null,
      "variants": [
        "Originale",
        "Variante 2",
        "Variante 3"
      ]
    },
    {
      "id": "AR-N04",
      "old_review_id": null,
      "content_id": null,
      "name": "Combat · tenue d’assaut",
      "kind": "outfit",
      "category": "new_combat",
      "source_reference": null,
      "source": "../../../../assets/source-art/refonte-agent-2026-10-06/armor-flat-review-01/sources/AR-N04-poses.png",
      "brief": "A mobile tactical combat outfit with a dark petrol-blue armored vest, sand-grey fabric sleeves and trousers, compact shoulder plates, a practical closed commando helmet, a wide visible protective chest panel, knee pads and substantial boots. Distinct from a heavy full plate suit; no guns, belt bullets or held items.",
      "status": "new_design_pending_review",
      "replaces_candidate": null,
      "variants": [
        "Originale",
        "Variante 2",
        "Variante 3"
      ]
    },
    {
      "id": "AR-N05",
      "old_review_id": null,
      "content_id": null,
      "name": "Métamorphe · combinaison organique",
      "kind": "outfit",
      "category": "metamorphe_replacement",
      "source_reference": null,
      "source": "../../../../assets/source-art/refonte-agent-2026-10-06/armor-flat-review-01/sources/AR-N05-poses.png",
      "brief": "A flexible dark violet-black augmented-human suit with substantial muted turquoise membrane panels, visible bone-ivory organic rib shapes on the chest and collar, short angular shoulder shells with two small biological protrusions, a predatory closed mask under a low narrow hood. Human anatomy in untransformed state. The silhouette and broad organic materials suggest future metamorphosis rather than generic hard robot armor. Black articulated gloves and boots; no antenna helmet, no full animal head, tail, wings, aura or transformation.",
      "status": "new_design_pending_review",
      "replaces_candidate": "AR-03",
      "variants": [
        "Originale",
        "Variante 2",
        "Variante 3"
      ]
    },
    {
      "id": "AR-N06",
      "old_review_id": null,
      "content_id": null,
      "name": "Métamorphe · manteau de mutation",
      "kind": "outfit",
      "category": "metamorphe_replacement",
      "source_reference": null,
      "source": "../../../../assets/source-art/refonte-agent-2026-10-06/armor-flat-review-01/sources/AR-N06-poses.png",
      "brief": "An occult mutation outfit in moss-green and bone-ivory, a short split organic mantle over a flexible charcoal bodysuit, broad leathery overlapping chest and shoulder scales, a high ribbed living collar around a closed dark facemask, a short pointed hood and ivory organic knee shells. All elements clearly blend augmented technology and biological occult mutation. Human untransformed body, not an armored robot or animal. Black articulated gloves and boots; no antenna helmet, huge horns, wings, tail, weapon, aura or transformation.",
      "status": "new_design_pending_review",
      "replaces_candidate": "AR-03",
      "variants": [
        "Originale",
        "Variante 2",
        "Variante 3"
      ]
    },
