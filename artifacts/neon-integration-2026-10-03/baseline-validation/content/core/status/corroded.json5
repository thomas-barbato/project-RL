{
  // Stable ID used by abilities and runtime instances.
  id: "core:corroded",
  duration_turns: 3,

  stacking: {
    // Reapplication renews the duration, never the damage intensity.
    mode: "refresh_duration",
  },

  hooks: [
    {
      trigger: "turn_end",
      effects: [
        {
          type: "deal_damage",
          amount: 2,
          damage_type: "chemical",
          penetration: 0,
          multiply_by_stacks: true,
        },
      ],
    },
  ],
}
