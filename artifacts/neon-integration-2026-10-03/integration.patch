+    }
+    let (base, light, shade) = match symbol {
+        '@' => (0xbcc9cf, 0xeff8f6, 0x5f7180),
+        'm' => (0xb2a377, 0xede2af, 0x655d46),
+        'v' => (0xb9a47c, 0xf1ddb0, 0x675645),
