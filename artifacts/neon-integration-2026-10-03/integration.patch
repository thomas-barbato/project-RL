+            'W' | 'C' => (0x8d9e72, 0xc1d49b, 0x3a5140),
+            'J' | 'O' => (0xa07399, 0xdb9bbb, 0x463044),
+            'I' => (0x80a9a1, 0xb9e3ce, 0x304a4b),
