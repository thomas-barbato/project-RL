+    /// Generation-only scaling. Called once, before insertion into a world;
+    /// body initialization must keep the same scaled base after materialization.
+    pub(crate) fn scale_spawned_combat(&mut self, vitality: u16, damage: u16) {
+        let scale = |base: u16| {
+            ((u32::from(base) * u32::from(vitality) + 50) / 100).clamp(1, u32::from(u16::MAX))
+                as u16
+        };
+        self.maximum_integrity = scale(self.maximum_integrity);
+        self.integrity = self.maximum_integrity;
+        if let Some(body) = &mut self.body_profile {
+            body.base_hit_points = scale(body.base_hit_points);
+        }
+        for attack in &mut self.attacks {
+            *attack = attack.with_damage_output_percentage(
+                (u32::from(attack.damage_output_percentage()) * u32::from(damage) / 100).min(800)
+                    as u16,
+            );
+        }
+    }
